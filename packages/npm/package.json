{
  "name": "chainsmith",
  "version": "0.1.0",
  "description": "A CLI tool that breaks down large projects into atomic tasks and runs each task through an AI coding agent automatically",
  "main": "bin/chainsmith.js",
  "bin": {
    "chainsmith": "bin/chainsmith.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "gpt",
    "ai",
    "automation",
    "orchestrator",
    "cli",
    "agent",
    "coding-assistant"
  ],
  "author": "Chinmay Shringi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChinmayShringi/Chainsmith.git"
  },
  "homepage": "https://github.com/ChinmayShringi/Chainsmith",
  "bugs": {
    "url": "https://github.com/ChinmayShringi/Chainsmith/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "bin/",
    "scripts/",
    "lib/",
    "README.md"
  ]
}
